# Copy to .env and fill in. Never commit .env.

# Runtime mode. Next.js sets this itself; set it only for scripts outside Next.
NODE_ENV=development

# Public origin of the app, including scheme and port (no trailing path).
APP_URL=http://localhost:3000

# Minimum log level: debug, info, warn or error. Defaults to info.
LOG_LEVEL=info

# Postgres connection for the app, as the least-privileged trask_app role (pooled endpoint on Neon).
DATABASE_URL=postgres://trask_app:change-me@localhost:5432/trask

# Postgres connection for migrations, as the trask_migrator role (direct endpoint on Neon). Read only by prisma.config.ts.
MIGRATION_DATABASE_URL=postgres://trask_migrator:change-me@localhost:5432/trask

# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
